#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int n, m;
    int positivos=0, negativos=0;
    cin >> n;
    while(n--){
        cin >> m;
        if(m < 0){
            negativos++;
        } else{
            positivos++;
        }
    }

    cout << negativos << " números negativos e " << positivos 
        << " números positivos";
     
    return 0;
}
