#include <bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    string palavra;

    cin >> palavra;

    int vogais = 0;

    for(char c:palavra){
        if(c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u'){
            vogais++;
        }
    }

    cout << vogais << '\n';
    
    return 0;
}
