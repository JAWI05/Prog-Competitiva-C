#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    string frase;
    getline(cin, frase);
    int espacos = 0;
    
    for(char c:frase){
        if(isspace(c)){
            espacos++;
        }
    }
    cout << espacos << '\n';
    
    return 0;
}
