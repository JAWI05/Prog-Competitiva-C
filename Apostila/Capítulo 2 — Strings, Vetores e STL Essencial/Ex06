#include <bits/stdc++.h>
using namespace std;

int main() {

    vector<string> palavras;
    int n;
    cin >> n;

    for(int i=0; i<n; i++){
        string palavra;
        cin >> palavra;
        palavras.push_back(palavra);
    }

    sort(palavras.begin(), palavras.end());

    for(string p:palavras){
        cout << p << '\n';
    }
    
    return 0;
}
